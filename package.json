{
  "name": "savings-squads",
  "version": "1.0.0",
  "description": "Social group savings challenge platform for Zolve Hackathon",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\" --names \"server,client\" --prefix-colors \"magenta,cyan\"",
    "server": "node server/index.js",
    "client": "vite",
    "build": "vite build",
    "install:all": "npm install"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.2",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.8.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4"
  }
}
